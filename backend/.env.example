APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host header allow-list. Set real hostnames when deployed.
ALLOWED_HOSTS=*

DATABASE_URL=
# Neon connections take ~6s to establish; a lower ceiling makes /health
# report degraded permanently.
DATABASE_PROBE_TIMEOUT_SECONDS=10

LLM_PROVIDER=ollama
# Blank = Ollama is selectable in development, disabled in production.
# Set true only for a self-hosted production that runs Ollama.
ENABLE_LOCAL_PROVIDERS=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180


ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=120


EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120


TRANSCRIPT_REPO=ChatPRD/lennys-podcast-transcripts
TRANSCRIPT_REPO_REF=main
TRANSCRIPT_CACHE_DIR=.transcript-cache
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=80


RETRIEVAL_TOP_K=8
# Measured: on-corpus best match 0.18-0.37, off-corpus 0.49-0.52.
RETRIEVAL_MAX_DISTANCE=0.45
RETRIEVAL_MIN_CHUNKS=2
