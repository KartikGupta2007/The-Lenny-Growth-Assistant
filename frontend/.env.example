# ---------------------------------------------------------------------------
# Lenny Growth Assistant - frontend configuration
#
# Copy to `frontend/.env` and edit. `.env` is gitignored.
#   cp frontend/.env.example frontend/.env
#
# Only VITE_-prefixed variables are exposed to the browser bundle. Never put a
# secret here: the frontend talks exclusively to the FastAPI backend and holds
# no model-provider or database credentials of its own.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend.
#
# The frontend reads no environment switch of its own: which models are
# selectable is decided by the backend's APP_ENV and reported through
# GET /api/providers, so the same bundle behaves correctly in every
# environment without a rebuild.
VITE_API_BASE_URL=http://localhost:8000
